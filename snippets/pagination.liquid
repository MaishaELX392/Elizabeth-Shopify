{% if pagination.pages > 1 %}
  <nav role="navigation" class="pagination">
    {% if pagination.previous %}
      <a href="{{ pagination.previous.url }}" class="pagination__link pagination__link--arrow">
        Previous
      </a>
    {% endif %}

    <ul class="pagination__list">
      {%- for part in pagination.parts -%}
        <li>
          {%- if part.is_link -%}
            <a href="{{ part.url }}" class="pagination__link">{{ part.title }}</a>
          {%- else -%}
            {%- if part.title == pagination.current_page -%}
              <span class="pagination__link pagination__link--current" aria-current="page">{{ part.title }}</span>
            {%- else -%}
              <span class="pagination__dot">{{ part.title }}</span>
            {%- endif -%}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {% if pagination.next %}
      <a href="{{ pagination.next.url }}" class="pagination__link pagination__link--arrow">
        Next
      </a>
    {% endif %}
  </nav>
{% endif %}