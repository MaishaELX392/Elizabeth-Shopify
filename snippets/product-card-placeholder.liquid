<div class="product-card-placeholder-wrapper">

  <div class="product-card-placeholder">

    {{ 'product-1' | placeholder_svg_tag: 'product-card-placeholder__image' }}

    <div class="product-card-placeholder__info">

      <span class="product-card-placeholder__vendor">
        Vendor
      </span>

      <span class="product-card-placeholder__title">
        Placeholder title
      </span>

      <span class="product-card-placeholder__price">
        {{ '9999' | money }}
      </span>

    </div>

  </div>

</div>