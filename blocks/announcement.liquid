{{ 'announcement.css' | asset_url | stylesheet_tag }}

<div class="announcement-block" {{ block.shopify_attributes }}>

  {% if block.settings.heading != blank %}
    <h2 class="announcement-block__heading">
      {{ block.settings.heading }}
    </h2>
  {% endif %}

  {% if block.settings.text != blank %}
    <p class="announcement-block__text">
      {{ block.settings.text }}
    </p>
  {% endif %}

</div>

{% schema %}
{
  "name": "Announcement",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to our store"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Discover our latest collection."
    }
  ],
  "presets": [
    {
      "name": "Announcement"
    }
  ]
}
{% endschema %}