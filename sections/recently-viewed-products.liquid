
{{ 'recently-viewed-products.css' | asset_url | stylesheet_tag }}

<section
  id="RecentlyViewed-{{ section.id }}"
  class="rvp-section"
  data-rvp-section
  data-heading="{{ section.settings.heading | escape }}"
  data-limit="{{ section.settings.product_limit }}"
  data-show-price="{{ section.settings.show_price }}"
  hidden
>
  <div class="rvp-section__container">
 <h2 class="rvp-section__heading">
  Recently Viewed Products
</h2>

    <div class="rvp-products" data-rvp-products></div>
  </div>
</section>

{% schema %}
{
  "name": "Recently viewed products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently Viewed Products"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Number of products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show product prices",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Recently viewed products"
    }
  ]
}
{% endschema %}
