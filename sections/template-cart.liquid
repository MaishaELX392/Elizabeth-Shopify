{{ 'template-cart.css' | asset_url | stylesheet_tag }}

{% if cart.item_count > 0 %}

  <div class="template-cart">

```
<div class="template-cart__header-wrapper">

  <div class="template-cart__header">

    <div class="template-cart__header-content">

      <div class="template-cart__title-row">

        <h1 class="template-cart__title">
          Your cart
        </h1>

        <a
          href="{{ routes.all_products_collection_url }}"
          class="template-cart__continue"
        >
          Continue shopping
        </a>

      </div>

    </div>

  </div>

</div>


<div class="template-cart__content-wrapper">

  <form
    action="{{ routes.cart_url }}"
    method="POST"
    novalidate
    class="template-cart__form"
  >

    <table class="template-cart__table">

      <thead>

        <tr>

          <th class="template-cart__heading">
            Product
          </th>

          <th class="template-cart__heading">
            Quantity
          </th>

          <th class="template-cart__heading">
            Total Price
          </th>

        </tr>

      </thead>


      <tbody>

        {% for item in cart.items %}

          <tr class="template-cart__item">

            <td class="template-cart__product">

              <a href="{{ item.url }}">

                {% if item.image %}

                  <img
                    src="{{ item.image | img_url: 'small' }}"
                    alt="{{ item.title | escape }}"
                    class="template-cart__image"
                  >

                {% else %}

                  {{ 'product-1' | placeholder_svg_tag: 'template-cart__placeholder' }}

                {% endif %}

              </a>


              <div class="template-cart__product-info">

                <a
                  href="{{ item.url }}"
                  class="template-cart__product-title"
                >
                  {{ item.product.title | truncatewords: 5 }}
                </a>

                <span class="template-cart__variant">
                  {{ item.variant.title }}
                </span>

                <a
                  href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0"
                  class="template-cart__remove"
                >
                  Remove
                </a>

              </div>

            </td>


            <td class="template-cart__quantity">

              <input
                type="number"
                name="updates[]"
                id="updates_{{ forloop.index }}"
                value="{{ item.quantity }}"
                min="0"
                class="template-cart__quantity-input"
              >

            </td>


            <td class="template-cart__price">

              {{ item.line_price | money }}

            </td>

          </tr>

        {% endfor %}

      </tbody>

    </table>


    <div class="template-cart__bottom">

      <div class="template-cart__notes">

        <label for="cart_note">
          Cart notes
        </label>

        <textarea
          name="note"
          id="cart_note"
          class="template-cart__notes-input"
        ></textarea>

      </div>


      <div class="template-cart__summary">

        {% for block in section.blocks %}

          {% case block.type %}

            {% when 'subtotal' %}

              <h3 class="template-cart__subtotal">
                Subtotal: {{ cart.total_price | money }}
              </h3>


            {% when 'update_button' %}

              <div class="template-cart__button-wrapper">

                <button
                  type="submit"
                  name="update"
                  class="template-cart__button template-cart__button--update"
                >
                  Update
                </button>

              </div>


            {% when 'checkout_button' %}

              <div class="template-cart__button-wrapper">

                <button
                  type="submit"
                  name="checkout"
                  class="template-cart__button template-cart__button--checkout"
                >
                  Checkout
                </button>

              </div>

          {% endcase %}

        {% endfor %}

      </div>

    </div>

  </form>

</div>
```

  </div>

{% else %}

  <div class="template-cart template-cart--empty">

```
<div class="template-cart__empty">

  <div class="template-cart__empty-content">

    <h1 class="template-cart__empty-title">
      Your cart is empty
    </h1>

    <div class="template-cart__empty-action">

      <a
        href="{{ routes.all_products_collection_url }}"
        class="template-cart__empty-button"
      >
        Continue shopping
      </a>

    </div>

  </div>

</div>
```

  </div>

{% endif %}

{% schema %}
{
"name": "Template Cart",
"blocks": [
{
"type": "subtotal",
"name": "Subtotal",
"limit": 1
},
{
"type": "update_button",
"name": "Update Button",
"limit": 1
},
{
"type": "checkout_button",
"name": "Checkout Button",
"limit": 1
}
]
}
{% endschema %}
