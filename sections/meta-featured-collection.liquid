{{ 'meta-featured-collection.css' | asset_url | stylesheet_tag }}

{% assign entry = section.settings.metaobject_entry %}

{% if entry != blank %}
  <div 
    class="meta-collection-section" 
    style="
      --bg-color: {{ section.settings.background_color }};
      --text-color: {{ section.settings.text_color }};
    "
  >
    <div class="meta-collection-container">
      
      <div class="meta-collection-header">
        {% if entry.banner_image.value != blank %}
          <div class="meta-collection-banner">
            {{ entry.banner_image.value | image_url: width: 1400 | image_tag: loading: 'lazy', alt: entry.headline.value }}
          </div>
        {% endif %}

        <div class="meta-collection-details">
          {% if entry.custom_badge.value != blank %}
            <span class="meta-collection-badge">{{ entry.custom_badge.value }}</span>
          {% endif %}

          {% if entry.headline.value != blank %}
            <h2 class="meta-collection-title">{{ entry.headline.value }}</h2>
          {% endif %}

          {% if entry.description.value != blank %}
            <div class="meta-collection-description">
              {{ entry.description.value | metafield_tag }}
            </div>
          {% endif %}
        </div>
      </div>

      {% assign target_collection = entry.featured_collection.value %}
      {% if target_collection != blank and target_collection.products_count > 0 %}
        <div class="meta-product-grid" id="MetaProductGrid-{{ section.id }}">
          {% for product in target_collection.products limit: section.settings.total_products_limit %}
            <div 
              class="meta-product-grid__item{% if forloop.index > 2 and forloop.index <= 4 %} meta-product-grid__item--mobile-hidden{% endif %}{% if forloop.index > 4 %} meta-product-grid__item--hidden{% endif %}"
              data-product-index="{{ forloop.index }}"
            >
              {% render 'card-product', card_product: product %}
            </div>
          {% endfor %}
        </div>

        {% if target_collection.products_count > 2 %}
          <div class="meta-collection-actions">
            <button 
              type="button" 
              class="meta-collection-view-more-btn"
              id="ViewMoreBtn-{{ section.id }}"
              onclick="toggleMetaProducts('{{ section.id }}')"
            >
              View More
            </button>
          </div>
        {% endif %}
      {% endif %}

    </div>
  </div>

  <script>
 
function toggleMetaProducts(sectionId) {
  const grid = document.getElementById(`MetaProductGrid-${sectionId}`);
  const btn = document.getElementById(`ViewMoreBtn-${sectionId}`);

  if (!grid || !btn) return;

  const hiddenItems = grid.querySelectorAll(
    '.meta-product-grid__item--hidden, .meta-product-grid__item--mobile-hidden'
  );

  if (hiddenItems.length) {
    hiddenItems.forEach(item => {
      item.classList.remove(
        'meta-product-grid__item--hidden',
        'meta-product-grid__item--mobile-hidden'
      );
    });

    btn.textContent = 'View Less';
    return;
  }

  const isMobile = window.innerWidth <= 749;

  grid.querySelectorAll('.meta-product-grid__item').forEach((item, index) => {
    if (isMobile && index >= 2 && index < 4) {
      item.classList.add('meta-product-grid__item--mobile-hidden');
    } else if (index >= 4) {
      item.classList.add('meta-product-grid__item--hidden');
    }
  });

  btn.textContent = 'View More';
}

  </script>
{% endif %}

{% schema %}
{
  "name": "Meta Featured Collection",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "metaobject",
      "id": "metaobject_entry",
      "label": "Curated Collection Entry",
      "metaobject_type": "curated_collection"
    },
    {
      "type": "range",
      "id": "total_products_limit",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12,
      "label": "Total products pool limit"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Meta Featured Collection"
    }
  ]
}
{% endschema %}