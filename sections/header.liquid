{{ 'header.css' | asset_url | stylesheet_tag }}

<div
  class="site-header"
  x-data="{ mobileMenuOpen: false, searchBarOpen: false }"
>
  <div class="site-header__container">


<div class="site-header__inner">

  <!-- STORE NAME -->
  <div class="site-header__logo">
    <h1 class="site-header__logo-title">
      {{ section.settings.store_name }}
    </h1>
  </div>

  <!-- MOBILE MENU BUTTON -->
  <div class="site-header__mobile-toggle">
    <button
      x-on:click="mobileMenuOpen = true"
      type="button"
      class="site-header__mobile-button"
      aria-label="Open menu"
    >
      {% render 'icon-menu' %}
    </button>
  </div>

  <!-- DESKTOP NAVIGATION -->
  <nav class="site-header__nav">

    {% if section.settings.menu.links == blank %}
      {% assign main_menu_linklist = linklists[section.settings.menu].links %}
    {% else %}
      {% assign main_menu_linklist = section.settings.menu.links %}
    {% endif %}

    {% for link in main_menu_linklist %}

      {% if link.links != blank %}

        {% assign link_handle = link.handle | replace: '-', '_' %}

        <div
          class="site-header__nav-item"
          x-data="{ {{ link_handle }}: false }"
        >

          <button
            type="button"
            x-on:click="{{ link_handle }} = !{{ link_handle }}"
            :aria-expanded="{{ link_handle }}"
            class="site-header__nav-button"
          >
            <span>{{ link.title }}</span>

            {% render 'icon-dropdown' %}
          </button>

          <div
            x-show="{{ link_handle }}"
            x-cloak
            @click.outside="{{ link_handle }} = false"
            class="site-header__dropdown"
          >

            <div class="site-header__dropdown-wrapper">

              <div class="site-header__dropdown-content">

                {% for childlink in link.links %}

                  <a
                    href="{{ childlink.url }}"
                    class="site-header__dropdown-link"
                  >

                    <div class="site-header__dropdown-content-inner">
                      <p>
                        {{ childlink.title }}
                      </p>
                    </div>

                  </a>

                {% endfor %}

              </div>

            </div>

          </div>

        </div>

      {% else %}

        <a
          href="{{ link.url }}"
          class="site-header__nav-link"
        >
          {{ link.title }}
        </a>

      {% endif %}

    {% endfor %}

  </nav>

  <!-- DESKTOP ACTIONS -->
  <div class="site-header__actions">

    <!-- SEARCH -->
    <button
      x-on:click="searchBarOpen = true"
      type="button"
      class="site-header__action-button"
      aria-label="Search"
    >
      {% render 'icon-search' %}
    </button>

    <!-- CART -->
    <a
      href="{{ routes.cart_url }}"
      class="site-header__action-link"
      aria-label="Cart"
    >
      {% render 'icon-shopping-bag' %}
    </a>

    <!-- CUSTOMER -->
    {% if shop.customer_accounts_enabled %}

      {% if customer %}

        <a
          href="{{ routes.account_url }}"
          class="site-header__action-link"
        >
          Account
        </a>

        {{ 'Log out'
          | customer_logout_link
          | replace: '<a', '<a class="site-header__action-link"'
        }}

      {% else %}

        {% if section.settings.show_login %}
          {{ 'Log in'
            | customer_login_link
            | replace: '<a', '<a class="site-header__action-link"'
          }}
        {% endif %}

        {% if section.settings.show_register %}
          {{ 'Register'
            | customer_register_link
            | replace: '<a', '<a class="site-header__action-link"'
          }}
        {% endif %}

      {% endif %}

    {% endif %}

  </div>

</div>


  </div>

  <!-- MOBILE MENU -->

  <div
    x-show="mobileMenuOpen"
    x-cloak
    class="site-header__mobile-menu"
  >


<div class="site-header__mobile-menu-inner">

  <div class="site-header__mobile-menu-content">

    <!-- MOBILE MENU HEADER -->
    <div class="site-header__mobile-menu-header">

      <div>
        <h1 class="site-header__mobile-menu-title">
          {{ section.settings.mobile_menu_title }}
        </h1>
      </div>

      <div class="site-header__mobile-close-wrapper">

        <button
          x-on:click="mobileMenuOpen = false"
          type="button"
          class="site-header__mobile-close"
          aria-label="Close menu"
        >
          {% render 'icon-close' %}
        </button>

      </div>

    </div>

    <!-- MOBILE NAVIGATION -->
    <div class="site-header__mobile-navigation">

      <nav class="site-header__mobile-nav">

        {% if section.settings.menu.links == blank %}
          {% assign main_menu_linklist = linklists[section.settings.menu].links %}
        {% else %}
          {% assign main_menu_linklist = section.settings.menu.links %}
        {% endif %}

        {% for link in main_menu_linklist %}

          {% if link.links != blank %}

            {% assign mobile_link_handle = link.handle | replace: '-', '_' %}

            <div
              class="site-header__mobile-nav-group"
              x-data="{ {{ mobile_link_handle }}: false }"
            >

              <button
                x-on:click="{{ mobile_link_handle }} = !{{ mobile_link_handle }}"
                type="button"
                class="site-header__mobile-nav-parent"
              >

                <span>
                  {{ link.title }}
                </span>

                {% render 'icon-dropdown' %}

              </button>

              <div
                x-show="{{ mobile_link_handle }}"
                x-cloak
                class="site-header__mobile-submenu"
              >

                {% for childlink in link.links %}

                  <a
                    href="{{ childlink.url }}"
                    class="site-header__mobile-nav-link"
                  >
                    {{ childlink.title }}
                  </a>

                {% endfor %}

              </div>

            </div>

          {% else %}

            <a
              href="{{ link.url }}"
              class="site-header__mobile-nav-link"
            >
              {{ link.title }}
            </a>

          {% endif %}

        {% endfor %}

      </nav>

    </div>

  </div>

</div>

  </div>

  <!-- SEARCH BAR -->

  <div
    x-show="searchBarOpen"
    x-cloak
    class="site-header__search"
  >


<button
  type="button"
  x-on:click="searchBarOpen = false"
  class="site-header__search-close"
  aria-label="Close search"
>
  {% render 'icon-close' %}
</button>

<div class="site-header__search-inner">

  <form
    action="{{ routes.search_url }}"
    method="get"
    class="site-header__search-form"
  >

    <div class="site-header__search-field">

      <input
        type="search"
        name="q"
        placeholder="Search"
        class="site-header__search-input"
        autocomplete="off"
      >

      <button
        type="submit"
        class="site-header__search-submit"
        aria-label="Submit search"
      >
        {% render 'icon-search' %}
      </button>

    </div>

  </form>

</div>


  </div>

</div>

{% schema %}
{
"name": "Header",
"tag": "header",
"class": "site-header-section",
"limit": 1,

"settings": [
{
"type": "link_list",
"id": "menu",
"label": "Menu",
"default": "main-menu"
},
{
"type": "text",
"id": "store_name",
"label": "Store name",
"default": "STORE NAME"
},
{
"type": "text",
"id": "mobile_menu_title",
"label": "Mobile menu title",
"default": "MENU"
},
{
"type": "checkbox",
"id": "show_login",
"label": "Show Login",
"default": true
},
{
"type": "checkbox",
"id": "show_register",
"label": "Show Register",
"default": true
}
],

"blocks": [
{
"type": "header_link",
"name": "Header link",
"limit": 5,
"settings": [
{
"type": "text",
"id": "title",
"label": "Title",
"default": "Header link"
},
{
"type": "url",
"id": "url",
"label": "Link"
}
]
}
],

"max_blocks": 5,

"presets": [
{
"name": "Header"
}
],

"locales": {
"en": {
"store_name": "STORE NAME",
"mobile_menu_title": "MENU"
},
"fr": {
"store_name": "NOM DE LA BOUTIQUE",
"mobile_menu_title": "MENU"
}
}
}
{% endschema %}
